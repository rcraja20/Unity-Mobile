[application]
config/name="RC Mobile Studio"
config/description="RC Empire mobile-first game development studio powered by the Godot open-source engine foundation."
run/main_scene="res://studio.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
